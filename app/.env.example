# ─── Pebble frontend env ──────────────────────────────────────────────────────
# Public keys only — safe to expose in the browser bundle.
# Get these from your Supabase project: Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: sub-path hosting (GitHub Pages project sites). Cloudflare Pages
# custom domains and local dev use "/" — leave unset.
# PAGES_BASE=/pebble/

# NEVER put the service_role / secret key here. It lives only as an
# Edge Function secret (SUPABASE_SERVICE_ROLE_KEY).
